# ---------- Self-hosted Supabase ----------
# Shared with Helal Community apps; see COLLABORATOR-ACCESS.md for the
# namespacing rules (anything new must start with `podcast_`).
SUPABASE_URL=https://supabase.abdallahhelal.com
SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_JWT_SECRET=change-me

# ---------- Self-hosted LiveKit ----------
# Single-subdomain scheme: nginx proxies /livekit/* -> 127.0.0.1:7880 and strips
# the prefix. Browsers refuse ws:// from an https:// page, so wss:// is required.
LIVEKIT_URL=wss://podcast.abdallahhelal.com/livekit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=change-me-at-least-32-chars

# ---------- Backend ----------
# Same origin as the frontend (single subdomain, nginx routes /api/* -> :8000).
BACKEND_URL=https://podcast.abdallahhelal.com
CORS_ORIGINS=https://podcast.abdallahhelal.com

# ---------- Worker ----------
WORKER_POLL_INTERVAL_SEC=5
WORKER_MAX_ATTEMPTS=3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Optional: set an HF token so the first Whisper model download isn't throttled.
HF_TOKEN=

# ---------- Frontend (NEXT_PUBLIC_* is inlined at build time) ----------
# Same origin as the backend; frontend calls podcast.abdallahhelal.com/api/v1/...
NEXT_PUBLIC_SUPABASE_URL=https://supabase.abdallahhelal.com
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
NEXT_PUBLIC_BACKEND_URL=https://podcast.abdallahhelal.com

# ---------- Error tracking (optional) ----------
# Leave empty to disable. Sentry stays uninitialized, calls become no-ops.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
