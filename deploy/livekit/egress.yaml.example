# /opt/livekit/egress.yaml (chmod 640 root:root; the egress user is in gid 0).
api_key: <LIVEKIT_API_KEY>
api_secret: <LIVEKIT_API_SECRET>
ws_url: ws://127.0.0.1:7880
redis:
  address: 127.0.0.1:6390
  password: "<REDIS_PASSWORD>"
logging:
  level: info
health_port: 7981
cpu_cost:
  # Defaults (participant 2.0 CPUs, 80 % max) would refuse the second
  # person on this shared 6-core box. A 720p participant encode measured
  # ~0.9 core; 0.6 admits four at once (2.7 of the 3-CPU cap) so a quick
  # Stop → Record isn't refused while the old run's two are still finishing.
  max_cpu_utilization: 0.9
  participant_cpu_cost: 0.6
