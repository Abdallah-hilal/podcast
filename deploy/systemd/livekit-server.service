# systemd unit for the LiveKit server binary.
# Install:
#   # Fetch the binary first (one-time):
#   curl -sSL https://get.livekit.io | bash
#   sudo mv livekit-server /usr/local/bin/
#   sudo mkdir -p /opt/livekit && sudo cp deploy/livekit.yaml /opt/livekit/
#
#   sudo cp deploy/systemd/livekit-server.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now livekit-server.service

[Unit]
Description=LiveKit WebRTC server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/livekit-server --config /opt/livekit/livekit.yaml
Restart=on-failure
RestartSec=5
LimitNOFILE=65536
# WebRTC needs the ability to bind UDP ports 50000-60000.
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
